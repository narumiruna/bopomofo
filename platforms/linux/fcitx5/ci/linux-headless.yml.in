# Preparation snippet for the owner of .github/workflows. Not an active workflow.
# This builds/tests on native Linux CPUs; it does not test a desktop session.
name: Linux Fcitx5 headless
on:
  push:
  pull_request:
  workflow_dispatch:
permissions:
  contents: read
jobs:
  fcitx5-headless:
    strategy:
      fail-fast: false
      matrix:
        runner: [ubuntu-24.04, ubuntu-24.04-arm]
    runs-on: ${{ matrix.runner }}
    timeout-minutes: 20
    steps:
      - uses: actions/checkout@11bd71901bbe5b1630ceea73d27597364c9af683 # v4.2.2
      - name: Build isolated Linux environment
        run: docker build -t bopomofo-fcitx5-check -f platforms/linux/fcitx5/ci/Dockerfile platforms/linux/fcitx5/ci
      - name: Build addon and run ABI/replay/headless Fcitx API contracts
        run: docker run --rm --mount "type=bind,source=$PWD,target=/src,readonly" bopomofo-fcitx5-check
